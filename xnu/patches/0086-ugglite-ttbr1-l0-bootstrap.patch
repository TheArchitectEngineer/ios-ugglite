 /*
+ * Ugglite's 4K TTBR1 range starts at level 0, because the Apple kernel link
+ * address is 0xfffffe0000000000.  The identity TTBR0 map stays level 1.
+ */
+.macro create_l0_table_entry
+	and		$3,	$0, #(ARM_TT_L0_INDEX_MASK)
+	lsr		$3, $3, #(ARM_TT_L0_SHIFT)
+	lsl		$3, $3, #(TTE_SHIFT)
+	add		$3, $1, $3
+	mov		$4, #(ARM_TTE_BOOT_TABLE)
+	and		$5, $2, #(ARM_TTE_TABLE_MASK)
+	orr		$5, $4, $5
+	str		$5, [$3]
+.endmacro
