--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1831,23 +1831,39 @@
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ *
+ * The alias must cover the WHOLE panel, not one L2 block. Ugglite's splash
+ * buffer is 720x1280 at a 2160-byte stride = 0x2a3000 bytes, i.e. 2 MiB
+ * rounded up, so a single ARM_TT_L2_SIZE block ends at row 970 and the
+ * bottom marker band (rows 1248..1279, byte 0x292200) falls 0x92200 bytes
+ * past the end. The first sweet_early_mark() after the relocate then wrote
+ * to an unmapped VA, took a translation fault and hung the boot - which is
+ * exactly what the stage-32 panel showed.
  */
+#define UGG_EARLY_FB_BYTES ((uint64_t)UGG_EARLY_HEIGHT * UGG_EARLY_STRIDE)
+#define UGG_EARLY_FB_BLOCKS \
+	((UGG_EARLY_FB_BYTES + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE)
 #define UGG_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = UGG_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + UGG_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = (tt_entry_t)UGG_EARLY_FB_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+
+	/* One block per 2 MiB of panel, PA advancing with the VA. */
+	for (uint64_t i = 0; i < UGG_EARLY_FB_BLOCKS; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = (tt_entry_t)(UGG_EARLY_FB_PA + i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
