--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -951,7 +951,21 @@
 #endif /* !__ARM64_PMAP_SUBPAGE_L1__ */
 #else /* __ARM_16K_PG__ */
 #if defined(UGGLITE)
-#define T0SZ_BOOT 23ULL
+/*
+ * Ugglite is a 4K-granule build on a Cortex-A53, so the translation walk
+ * must use the standard 48-bit/4-level geometry: T0SZ=16 gives a 48-bit VA
+ * whose level-0 index is VA[47:39] (9 bits).
+ *
+ * This is not a free choice. pmap_table_level_info_4k[] indexes with the
+ * fixed ARM_4K_TT_L0_INDEX_MASK (bits 47:39), and start.s's
+ * create_l0_table_entry uses the same mask, so the hardware walk and the
+ * software that fills the tables must agree on a 9-bit L0 index. A smaller
+ * TSZ (e.g. 23, a 41-bit VA) narrows the hardware L0 index to VA[40:39]
+ * (2 bits) while the software keeps writing at index VA[47:39], so every
+ * bootstrap entry lands at the wrong index and the first fetch after
+ * MSR SCTLR_EL1 takes a level-0 translation fault.
+ */
+#define T0SZ_BOOT 16ULL
 #elif __ARM64_PMAP_SUBPAGE_L1__
 #define T0SZ_BOOT 26ULL
 #else /* __ARM64_PMAP_SUBPAGE_L1__ */
@@ -972,11 +986,12 @@
 #else /* __ARM_16K_PG__ */
 #if defined(UGGLITE)
 /*
- * VM_KERNEL_LINK_ADDRESS is 0xfffffe0000000000.  Both 4K translation regions
- * therefore need level-0 roots (TSZ=23), rather than the generic 256GB L1
- * configuration. Keeping T0SZ and T1SZ equal also matches pmap geometry.
+ * Same 48-bit/4-level geometry as T0SZ above, so TTBR1 walks with a 9-bit
+ * L0 index. VM_KERNEL_LINK_ADDRESS (0xfffffe0007004000) lies inside the
+ * TTBR1 region for T1SZ=16 (base 0xffff000000000000). Keeping T1SZ equal to
+ * T0SZ also keeps kernel_pmap->min in step with the link address.
  */
-#define T1SZ_BOOT 23ULL
+#define T1SZ_BOOT 16ULL
 #elif __ARM64_PMAP_SUBPAGE_L1__
 #define T1SZ_BOOT 26ULL
 #else /* __ARM64_PMAP_SUBPAGE_L1__ */
