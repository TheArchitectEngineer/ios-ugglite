--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -219,6 +219,21 @@
 	if (aff0 >= 16) {
 		panic("SWEET CPU: SGI target requires unsupported range selector");
 	}
+#if defined(SWEET_GIC_V2)
+	/*
+	 * GICv2 has no ICC_SGI1R_EL1: an SGI is raised by writing the
+	 * distributor's GICD_SGIR (0xf00):
+	 *   [25:24] target list filter, 0b00 = use the target list below
+	 *   [23:16] INTID
+	 *   [15:0]  target list, one bit per CPU interface
+	 * pe_init_fiq() already mapped the distributor, so this goes through
+	 * that same window instead of remapping it on every interrupt.
+	 */
+	uint32_t sgir = ((uint32_t)SWEET_IPI_SGI << 16) | (1U << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	sweet_gic_send_sgi(sgir);
+	__builtin_arm_isb(ISB_SY);
+#else
 	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
 	    (((mpidr >> 16) & 0xff) << 32) |
 	    (((mpidr >> 8) & 0xff) << 16) |
@@ -226,6 +241,7 @@
 	__builtin_arm_dsb(DSB_ISHST);
 	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
 	__builtin_arm_isb(ISB_SY);
+#endif
 }
 
 kern_return_t
