--- /dev/null
+++ b/pexpert/pexpert/arm64/UGGLITE.h
@@ -0,0 +1,88 @@
+/*
+ * Board config for the Redmi Note 5A ("ugglite", Qualcomm MSM8917 +
+ * PM8937): 4x Cortex-A53, ARMv8.0, no PAC, no 16K granule.
+ *
+ * This target is the 4K-granule counterpart of SWEET. The two facts that
+ * differ from sweet and reach into the kernel core:
+ *
+ *  1. The Cortex-A53 implements only 4K and 64K translation granules
+ *     (measured on the device: ID_AA64MMFR0_EL1 = 0x1122, TGran16 = 0).
+ *     So __ARM_16K_PG__ is NOT defined and ARM_PGSHIFT stays 12.
+ *
+ *  2. The iOS 16 userspace is built for 16K pages. That is still fine: on a
+ *     non-16K build with more than 1 GiB of RAM, arm_init() selects
+ *     PAGE_SHIFT_CONST = PAGE_MAX_SHIFT (14), so the VM page size is 16K
+ *     while the hardware granule is 4K. PAGE_RATIO is then 4 and the pmap
+ *     writes four 4K PTEs per 16K VM page - the A7/A8 arrangement. ugglite
+ *     has 2 GiB, so this branch is taken automatically.
+ *
+ * The interrupt controller is GICv2 (qcom,msm-qgic2), not GICv3: no
+ * redistributors, and the CPU interface is a second MMIO frame. Everything
+ * is still taken as a Group 1 IRQ through the same sleh_irq() path, because
+ * Qualcomm's GIC has two security states and TrustZone owns Group 0.
+ */
+
+#ifndef _PEXPERT_ARM64_UGGLITE_H
+#define _PEXPERT_ARM64_UGGLITE_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define UGGLITE                   1
+#define SWEET                     1     /* shares the SWEET driver code paths */
+#define SWEET_GIC_V2              1     /* selects the GICv2 implementation */
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+
+/*
+ * Cortex-A53 is ARMv8.0. Do NOT set __ARM_PAN_AVAILABLE__ (PAN is ARMv8.1),
+ * __ARM_V8_CRYPTO_EXTENSIONS__ (optional on A53, and the boot CPU must be
+ * checked before relying on it) or __ARM_16K_PG__ (no such granule).
+ *
+ * __ARM64_PMAP_SUBPAGE_L1__ matches the BCM2837 (4K-granule) config and lets
+ * the pmap use level-1 subpages, which a 4K root table needs for the VM
+ * region sizes this kernel uses.
+ */
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+
+/*
+ * Qualcomm numbers the architected timer PPIs 2/3/4/1 (secure phys, phys,
+ * virt, hyp) on MSM8917, so the virtual timer XNU uses (CNTV) is
+ * INTID 16 + 4 = 20. Verified against the live device tree on the phone.
+ */
+#define SWEET_VTIMER_INTID        20
+#define SWEET_IPI_SGI             1       /* SGI used for cross-CPU signals */
+
+#define GIC_SPURIOUS_IRQ          1023    /* IRQ no. for GIC spurious interrupt */
+
+/* GICv2 register definitions; see the GICv2 architecture spec (IHI 0048B). */
+#define GICD_CTLR                 0x000
+#define GICD_TYPER                0x004
+#define GICD_IGROUPR              0x080
+#define GICD_ISENABLER            0x100
+#define GICD_IPRIORITYR           0x400
+#define GICD_ICFGR                0xc00
+
+#define GICC_CTLR                 0x000
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00c
+#define GICC_EOIR                 0x010
+
+#define GICD_CTLR_ENABLE          0x1
+#define GICD_CTLR_RWP             0x80000000
+
+/* Still needed on GICv2: the Group 1 enable is an ICC_* system register. */
+#define ICC_SRE_SRE               0x1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+#endif /* ! _PEXPERT_ARM64_UGGLITE_H */
