+#define gicd2_write32(offset, data) (_gic2_write32(gicd_base + (offset), (data)))
+#define gicc2_read32(offset) (_gic2_read32(gicc_base + (offset)))
+#define gicc2_write32(offset, data) (_gic2_write32(gicc_base + (offset), (data)))
